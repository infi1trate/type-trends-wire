{
  "version": 1,
  "sdk_version": "3.4.0",
  "path": "/api/public/mcp",
  "auth": {
    "type": "none"
  },
  "mcp": {
    "server": {
      "name": "type-trends-wire",
      "version": "0.1.0",
      "title": "Type Trends Wire"
    },
    "tools": [
      {
        "name": "get_trend",
        "title": "Get a typeface's trend",
        "description": "Usage rank, trending rank, 7- and 28-day rank changes, band and daily history for one Google Fonts family.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "family": {
              "type": "string",
              "minLength": 2,
              "maxLength": 200,
              "description": "Family name, e.g. 'Inter', 'Instrument Serif'"
            }
          },
          "required": [
            "family"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "search_trends",
        "title": "Find typefaces that are moving",
        "description": "Ranks Google Fonts families by usage-rank change over a window, or Google's current trending order. Filter by category.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "direction": {
              "default": "rising",
              "type": "string",
              "enum": [
                "rising",
                "falling",
                "trending"
              ]
            },
            "category": {
              "type": "string",
              "enum": [
                "serif",
                "sans-serif",
                "display",
                "handwriting",
                "monospace"
              ]
            },
            "window_days": {
              "default": 28,
              "type": "integer",
              "minimum": 1,
              "maximum": 90
            },
            "limit": {
              "default": 15,
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "wire",
        "title": "Design news wire",
        "description": "Recent design news from design publications (RSS) and Hacker News. Filter by keyword, tag or source.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "query": {
              "description": "Words to match in title or excerpt",
              "type": "string",
              "maxLength": 300
            },
            "tag": {
              "type": "string",
              "enum": [
                "type",
                "color",
                "brand",
                "ui",
                "web",
                "motion",
                "ai"
              ]
            },
            "source": {
              "description": "e.g. 'Dezeen', 'Hacker News'",
              "type": "string",
              "maxLength": 100
            },
            "since_hours": {
              "default": 72,
              "type": "integer",
              "minimum": 1,
              "maximum": 720
            },
            "limit": {
              "default": 20,
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "library_site",
        "title": "Library site fingerprint",
        "description": "Latest design fingerprint, snapshot metadata and last 20 change events for a tracked domain; excludes skeleton and private text.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "domain": {
              "type": "string",
              "minLength": 3,
              "maxLength": 253,
              "pattern": "^(?!www\\.)(?:[a-z0-9](?:[a-z0-9-]*[a-z0-9])?\\.)+[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
            }
          },
          "required": [
            "domain"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "library_events",
        "title": "Library change events",
        "description": "Recent derived design changes across tracked sites, filtered by sector or event type.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "sector": {
              "type": "string",
              "enum": [
                "ai",
                "dev-tools",
                "fintech",
                "consumer-apps",
                "commerce-dtc",
                "media",
                "studios",
                "hardware",
                "health",
                "enterprise-saas"
              ]
            },
            "type": {
              "type": "string",
              "enum": [
                "type_change",
                "palette_shift",
                "theme_flip",
                "layout_change",
                "redesign",
                "message_pivot",
                "pricing_change",
                "new_surface",
                "stack_change",
                "nav_change",
                "imagery_shift",
                "aesthetic_shift"
              ]
            },
            "since_days": {
              "default": 30,
              "type": "integer",
              "minimum": 1,
              "maximum": 36500
            },
            "limit": {
              "default": 50,
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "library_sector",
        "title": "Library sector statistics",
        "description": "Sector statistics, top headline and body fonts with site counts, and theme split from latest desktop home captures.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "sector": {
              "type": "string",
              "enum": [
                "ai",
                "dev-tools",
                "fintech",
                "consumer-apps",
                "commerce-dtc",
                "media",
                "studios",
                "hardware",
                "health",
                "enterprise-saas"
              ]
            }
          },
          "required": [
            "sector"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "crawl_spread",
        "title": "Vanguard versus mainstream spread",
        "description": "Current crawler signal shares and spread points for English-language or all successful sites.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "scope": {
              "type": "string",
              "enum": [
                "en",
                "all"
              ]
            }
          },
          "required": [
            "scope"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "library_trends",
        "title": "AI-derived Library trends",
        "description": "Read public design tag shares and pricing, changelog or product-theme statistics, overall or by sector; no private page text or images.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "dimension": {
              "type": "string",
              "enum": [
                "imagery",
                "aesthetic",
                "components",
                "hero_layout",
                "ai_positioning",
                "tone",
                "color_mood",
                "pricing",
                "changelog",
                "features"
              ]
            },
            "sector": {
              "type": "string",
              "enum": [
                "ai",
                "dev-tools",
                "fintech",
                "consumer-apps",
                "commerce-dtc",
                "media",
                "studios",
                "hardware",
                "health",
                "enterprise-saas"
              ]
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "library_history",
        "title": "Library quarterly history",
        "description": "Read quarterly public design shares with capture denominators and coverage.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "dimension": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "sector": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "ai",
                    "dev-tools",
                    "fintech",
                    "consumer-apps",
                    "commerce-dtc",
                    "media",
                    "studios",
                    "hardware",
                    "health",
                    "enterprise-saas"
                  ]
                },
                {
                  "type": "string",
                  "const": "all"
                }
              ]
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "site_history",
        "title": "Site quarterly history",
        "description": "Read public quarterly site fingerprints and AI tags, without skeletons or private text.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "domain": {
              "type": "string",
              "minLength": 3,
              "maxLength": 253,
              "pattern": "^(?!www\\.)(?:[a-z0-9](?:[a-z0-9-]*[a-z0-9])?\\.)+[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
            }
          },
          "required": [
            "domain"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      }
    ]
  }
}
